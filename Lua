    }, notifHolder)
    local notifCount = 0

    function Window:Notify(cfg)
        cfg = cfg or {}
        local kind = cfg.Type or "Info"
        local colorKey = kind == "Success" and "Success" or kind == "Warning" and "Warning" or kind == "Error" and "Danger" or "Accent"
        local glyph = kind == "Success" and "✓" or kind == "Warning" and "!" or kind == "Error" and "✕" or "i"
        local dur = cfg.Duration or 4
        local content = cfg.Content or ""

        local textH = 0
        if content ~= "" then
            local ok, size = pcall(function()
                return TextService:GetTextSize(content, 12, Enum.Font.Gotham, Vector2.new(240, 1000))
            end)
            textH = ok and size.Y or 16
        end
        local h = 14 + 18 + (textH > 0 and (textH + 4) or 0) + 16

        notifCount += 1
        local wrap = new("Frame", { Size = UDim2.fromOffset(300, h), BackgroundTransparency = 1, LayoutOrder = notifCount }, notifHolder)
        local card = make("CanvasGroup", {
            Position = UDim2.new(1, 40, 0, 0), Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, GroupTransparency = 1,
        }, wrap, { BackgroundColor3 = "Section" })
        corner(card, 10)
        strokeT(card, "Border", 1, 0)
        make("Frame", { Size = UDim2.new(0, 3, 1, 0), BorderSizePixel = 0 }, card, { BackgroundColor3 = colorKey })

        -- icon bubble
        local icon = make("Frame", { Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(18, 18), BorderSizePixel = 0, BackgroundTransparency = 0.8 }, card, { BackgroundColor3 = colorKey })
        corner(icon, 999)
        label(icon, glyph, colorKey, { Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center })
        local iconScale = new("UIScale", { Scale = 0 }, icon)
        task.delay(0.25, function() tween(iconScale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back) end)

        label(card, cfg.Title or "Notification", "Text", { Position = UDim2.fromOffset(40, 10), Size = UDim2.new(1, -52, 0, 18), Font = Enum.Font.GothamBold })
        if content ~= "" then
            label(card, content, "Muted", {
                Position = UDim2.fromOffset(40, 32), Size = UDim2.new(1, -52, 0, textH), Font = Enum.Font.Gotham,
                TextSize = 12, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
            })
        end
        local bar = make("Frame", { Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 2), BorderSizePixel = 0, BackgroundTransparency = 0.35 }, card, { BackgroundColor3 = colorKey })

        tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.55, Enum.EasingStyle.Back)
        tween(card, { GroupTransparency = 0 }, 0.3)
        tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, dur, Enum.EasingStyle.Linear)

        local dismissed = false
        local function dismiss()
            if dismissed then return end
            dismissed = true
            tween(card, { Position = UDim2.new(1, 40, 0, 0), GroupTransparency = 1 }, 0.3)
            task.wait(0.3)
            tween(wrap, { Size = UDim2.fromOffset(300, 0) }, 0.2)
            task.wait(0.2)
            wrap:Destroy()
        end
        local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5 }, card)
        hit.Activated:Connect(function() task.spawn(dismiss) end)
        task.delay(dur, dismiss)
        return wrap
    end

    ---------------------------------------------------------------- feedback helpers
    function Window:Shake()
        local origin = root.Position
        task.spawn(function()
            for i = 1, 6 do
                local dir = (i % 2 == 0) and 1 or -1
                tween(root, { Position = origin + UDim2.fromOffset(dir * (9 - i), 0) }, 0.04)
                task.wait(0.04)
            end
            tween(root, { Position = origin }, 0.1)
        end)
    end

    ---------------------------------------------------------------- config
    function Window:GetConfig() return table.clone(Window.Config) end
    function Window:ExportConfig() return HttpService:JSONEncode(Window.Config) end
    function Window:SaveConfig(name)
        assert(type(name) == "string" and name ~= "", "Config name required")
        Window.NamedConfigs[name] = Window:GetConfig()
        return true
    end
    function Window:LoadConfig(data)
        if type(data) == "string" then
            local ok, result = pcall(function() return HttpService:JSONDecode(data) end)
            if not ok or type(result) ~= "table" then
                if Window.NamedConfigs[data] then result = Window.NamedConfigs[data] else return false end
            end
            data = result
        end
        if type(data) ~= "table" then return false end
        for id, v in pairs(data) do
            local c = Window.Controls[id]
            if c and c.Set then c.Set(v) end
        end
        return true
    end
    function Window:GetConfigs()
        local names = {}
        for n in pairs(Window.NamedConfigs) do table.insert(names, n) end
        table.sort(names)
        return names
    end
    function Window:DeleteConfig(name) Window.NamedConfigs[name] = nil end
    function Window:SaveToFile(name)
        if not writefile then return false end
        local folder = options.ConfigFolder or "IncrementalUi"
        pcall(function() if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end end)
        return (pcall(writefile, folder .. "/" .. name .. ".json", Window:ExportConfig()))
    end
    function Window:LoadFromFile(name)
        if not (readfile and isfile) then return false end
        local path = (options.ConfigFolder or "IncrementalUi") .. "/" .. name .. ".json"
        if not isfile(path) then return false end
        local ok, data = pcall(readfile, path)
        if not ok then return false end
        return Window:LoadConfig(data)
    end

    ---------------------------------------------------------------- tabs
    function Window:CreateTab(name, icon)
        local Tab = { Name = name, Sections = {}, Index = #Window.Tabs + 1 }

        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 34), Text = "", AutoButtonColor = false, BorderSizePixel = 0,
            BackgroundTransparency = 1, LayoutOrder = Tab.Index,
        }, tabList)
        corner(btn, 7)

        local hasIcon = type(icon) == "string" and string.find(icon, "rbxasset") ~= nil
        local textX = hasIcon and 36 or 14
        local lbl = label(btn, name, "Muted", { Position = UDim2.fromOffset(textX, 0), Size = UDim2.new(1, -textX - 8, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
        local img
        if hasIcon then
            img = make("ImageLabel", {
                BackgroundTransparency = 1, Image = icon, Size = UDim2.fromOffset(16, 16),
                AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0),
            }, btn, { ImageColor3 = "Muted" })
        end

        local hovering = false
        function Tab.Paint()
            local active = Window.ActiveTab == Tab
            tween(lbl, {
                TextColor3 = (active or hovering) and theme.Text or theme.Muted,
                Position = UDim2.fromOffset(textX + ((hovering and not active) and 4 or 0), 0),
            }, 0.2)
            if img then tween(img, { ImageColor3 = active and theme.Accent or theme.Muted }, 0.2) end
        end
        onTheme(Tab.Paint)
        btn.MouseEnter:Connect(function() hovering = true Tab.Paint() end)
        btn.MouseLeave:Connect(function() hovering = false Tab.Paint() end)

        local page = make("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
            ScrollBarThickness = 3, ScrollBarImageTransparency = 0.4, AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y,
        }, pagesHolder, { ScrollBarImageColor3 = "Muted" })
        new("UIListLayout", { Padding = UDim.new(0, 18), SortOrder = Enum.SortOrder.LayoutOrder }, page)
        new("UIPadding", { PaddingTop = UDim.new(0, 16), PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18), PaddingBottom = UDim.new(0, 20) }, page)
        Tab.Title = label(page, name, "Text", { Size = UDim2.new(1, 0, 0, 26), Font = Enum.Font.GothamBold, TextSize = 19, LayoutOrder = 0 })
        Tab.Page, Tab.Button = page, btn

        function Tab:Select() selectTab(Tab) end
        btn.Activated:Connect(function() selectTab(Tab) end)

        --------------------------------------------------------------- sections
        function Tab:CreateSection(sectionName)
            local sf = new("CanvasGroup", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                LayoutOrder = #Tab.Sections + 1,
            }, page)
            local pad = new("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }, sf)
            new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, sf)
            local head = label(sf, string.upper(sectionName or "Section"), "Muted", {
                Size = UDim2.new(1, 0, 0, 20), Font = Enum.Font.GothamBold, TextSize = 11, LayoutOrder = 0,
            })
            new("UIPadding", { PaddingLeft = UDim.new(0, 12) }, head)
            local headDot = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -10, 0.5, 0), Size = UDim2.fromOffset(3, 11), BorderSizePixel = 0 }, head, { BackgroundColor3 = "Accent" })
            corner(headDot, 999)
            local headLine = make("Frame", { Position = UDim2.new(0, -12, 1, -1), Size = UDim2.new(1, 12, 0, 1), BorderSizePixel = 0, BackgroundTransparency = 0.3 }, head, { BackgroundColor3 = "Border" })
            accentGrad(headLine, 0)
            headLine.BackgroundColor3 = Color3.new(1, 1, 1)
            local headLineGrad = headLine:FindFirstChildOfClass("UIGradient")
            if headLineGrad then
                headLineGrad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
            end

            local Section = { Rows = {} }
            table.insert(Tab.Sections, { Frame = sf, Rows = Section.Rows, Pad = pad, Line = headLine })
            local order = 0

            local function ripple(r)
                local m = UIS:GetMouseLocation() - GuiService:GetGuiInset()
                local s = uiScale.Scale
                local lx, ly = (m.X - r.AbsolutePosition.X) / s, (m.Y - r.AbsolutePosition.Y) / s
                local fx = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 10 }, r)
                corner(fx, 8)
                local dot = new("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(lx, ly), Size = UDim2.fromOffset(0, 0),
                    BackgroundColor3 = theme.Accent, BackgroundTransparency = 0.8, BorderSizePixel = 0,
                }, fx)
                corner(dot, 999)
                local d = math.max(r.AbsoluteSize.X, r.AbsoluteSize.Y) / s * 2.4
                tween(dot, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 }, 0.6, Enum.EasingStyle.Quad)
                task.delay(0.65, function() fx:Destroy() end)
            end

            local function shine(r)
                local fx = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 11 }, r)
                corner(fx, 8)
                local sw = new("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 46, 2, 0), Position = UDim2.new(-0.1, 0, 0.5, 0),
                    Rotation = 20, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.82, BorderSizePixel = 0,
                }, fx)
                new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }, sw)
                tween(sw, { Position = UDim2.new(1.1, 0, 0.5, 0) }, 0.55, Enum.EasingStyle.Quad)
                task.delay(0.6, function() fx:Destroy() end)
            end

            local function makeRow(height, text, clickable)
                order += 1
                local props = { Size = UDim2.new(1, 0, 0, height), BorderSizePixel = 0, LayoutOrder = order, BackgroundTransparency = 0.2 }
                if clickable then props.Text = "" props.AutoButtonColor = false end
                local r = make(clickable and "TextButton" or "Frame", props, sf, { BackgroundColor3 = "Element" })
                corner(r, 8)
                local st = strokeT(r, "Border", 1, 0.4)
                local edge = make("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(3, 0),
                    BorderSizePixel = 0, ZIndex = 3,
                }, r, { BackgroundColor3 = "Accent" })
                corner(edge, 999)
                table.insert(Section.Rows, { Frame = r, Text = text or "" })
                r.MouseEnter:Connect(function()
                    tween(r, { BackgroundColor3 = theme.ElementHover }, 0.15)
                    tween(st, { Color = theme.Accent, Transparency = 0.6 }, 0.2)
                    tween(edge, { Size = UDim2.fromOffset(3, math.floor(height * 0.55)) }, 0.25, Enum.EasingStyle.Back)
                end)
                r.MouseLeave:Connect(function()
                    tween(r, { BackgroundColor3 = theme.Element }, 0.15)
                    tween(st, { Color = theme.Border, Transparency = 0.4 }, 0.25)
                    tween(edge, { Size = UDim2.fromOffset(3, 0) }, 0.2)
                end)
                if clickable then
                    r.MouseButton1Down:Connect(function()
                        tween(r, { BackgroundColor3 = theme.Border }, 0.08)
                        ripple(r)
                    end)
                    r.MouseButton1Up:Connect(function() tween(r, { BackgroundColor3 = theme.ElementHover }, 0.15) end)
                end
                return r, st
            end
            local function rowLabel(r, text, reserve)
                return label(r, text, "Text", { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -(14 + (reserve or 0)), 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
            end
            local function pulse(st)
                tween(st, { Color = theme.Accent, Transparency = 0 }, 0.1)
                task.delay(0.12, function() tween(st, { Color = theme.Border, Transparency = 0.4 }, 0.4) end)
            end

            -- Button
            function Section:CreateButton(cfg)
                cfg = cfg or {}
                local r, st = makeRow(38, cfg.Name, true)
                local lbl = rowLabel(r, cfg.Name or "Button", 40)
                local arrow = label(r, "›", "Muted", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, -1), Size = UDim2.fromOffset(16, 20), TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center })
                r.MouseEnter:Connect(function() tween(arrow, { Position = UDim2.new(1, -8, 0.5, -1), TextColor3 = theme.Accent }, 0.2, Enum.EasingStyle.Back) end)
                r.MouseLeave:Connect(function() tween(arrow, { Position = UDim2.new(1, -12, 0.5, -1), TextColor3 = theme.Muted }, 0.2) end)
                r.Activated:Connect(function()
                    pulse(st)
                    shine(r)
                    if cfg.Callback then task.spawn(cfg.Callback) end
                end)
                return { SetText = function(_, t) lbl.Text = t end, Fire = function() if cfg.Callback then task.spawn(cfg.Callback) end end }
            end

            -- Toggle
            function Section:CreateToggle(cfg)
                cfg = cfg or {}
                local id = cfg.ConfigKey or cfg.Flag
                local value = cfg.CurrentValue == true
                local r = makeRow(38, cfg.Name, true)
                rowLabel(r, cfg.Name or "Toggle", 62)
                local track = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(38, 20), BorderSizePixel = 0 }, r)
                corner(track, 999)
                local trackGlow = new("UIStroke", { Color = theme.Accent, Thickness = 0, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, track)
                local knob = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(14, 14), BorderSizePixel = 0 }, track)
                corner(knob, 999)
                local function paint(instant)
                    local d = instant and 0 or 0.22
                    tween(track, { BackgroundColor3 = value and theme.Accent or theme.Border }, d)
                    tween(trackGlow, { Thickness = value and 3 or 0, Transparency = value and 0.72 or 1, Color = theme.Accent }, d)
                    tween(knob, {
                        Position = value and UDim2.new(0, 21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                        BackgroundColor3 = value and theme.AccentText or theme.Muted,
                    }, d, Enum.EasingStyle.Back)
                end
                onTheme(function() paint(false) end)
                local function set(v)
                    value = v == true
                    paint(false)
                    if id then Window.Config[id] = value end
                    if cfg.Callback then task.spawn(cfg.Callback, value) end
                end
                r.Activated:Connect(function()
                    set(not value)
                    if value then
                        burst(r, r.AbsoluteSize.X / uiScale.Scale - 22, 19, theme.Accent, 8, 20, 12)
                    end
                end)
                r.MouseButton1Down:Connect(function() tween(knob, { Size = UDim2.fromOffset(17, 14) }, 0.1) end)
                local function release() tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.15) end
                r.MouseButton1Up:Connect(release)
                r.MouseLeave:Connect(release)
                if id then Window.Controls[id] = { Set = set } end
                paint(true)
                if id then Window.Config[id] = value end
                if cfg.Callback then task.spawn(cfg.Callback, value) end
                return { SetValue = set, GetValue = function() return value end }
            end

            -- Slider
            function Section:CreateSlider(cfg)
                cfg = cfg or {}
                local min = cfg.Range and cfg.Range[1] or 0
                local max = cfg.Range and cfg.Range[2] or 100
                local step = cfg.Increment or 1
                assert(max > min, "Invalid slider range")
                local suffix = cfg.Suffix or ""
                local id = cfg.ConfigKey or cfg.Flag
                local decimals = 0
                local frac = string.match(tostring(step), "%.(%d+)")
                if frac then decimals = #frac end
                local function snap(v)
                    v = math.clamp(min + math.floor((v - min) / step + 0.5) * step, min, max)
                    return tonumber(string.format("%." .. decimals .. "f", v))
                end
                local value = snap(cfg.CurrentValue or min)

                local r = makeRow(54, cfg.Name, false)
                label(r, cfg.Name or "Slider", "Text", { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -120, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
                local disp = label(r, "", "Accent", { Position = UDim2.new(1, -114, 0, 8), Size = UDim2.fromOffset(100, 18), Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right })

                local hit = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 28), Size = UDim2.new(1, -28, 0, 20) }, r)
                local track = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 4), BorderSizePixel = 0 }, hit, { BackgroundColor3 = "Background" })
                corner(track, 999)
                local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1) }, track)
                corner(fill, 999)
                accentGrad(fill, 0)
                local thumb = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3 }, track)
                corner(thumb, 999)
                local thumbStroke = strokeT(thumb, "Accent", 2, 0)

                local function render(instant)
                    local pct = (value - min) / (max - min)
                    local d = instant and 0 or 0.1
                    tween(fill, { Size = UDim2.new(pct, 0, 1, 0) }, d, Enum.EasingStyle.Quad)
                    tween(thumb, { Position = UDim2.new(pct, 0, 0.5, 0) }, d, Enum.EasingStyle.Quad)
                    disp.Text = tostring(value) .. suffix
                end
                local function set(nv)
                    local snapped = snap(nv)
                    if snapped == value then return end
                    value = snapped
                    render(false)
                    tween(disp, { TextSize = 15 }, 0.08)
                    task.delay(0.09, function() tween(disp, { TextSize = 13 }, 0.15) end)
                    if id then Window.Config[id] = value end
                    if cfg.Callback then task.spawn(cfg.Callback, value) end
                end

                local active = false
                local function fromInput(input)
                    local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                    set(min + (max - min) * pct)
                end
                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        active = true
                        tween(thumb, { Size = UDim2.fromOffset(16, 16) }, 0.12, Enum.EasingStyle.Back)
                        tween(thumbStroke, { Thickness = 5, Transparency = 0.6 }, 0.15)
                        fromInput(input)
                    end
                end)
                connect(UIS.InputChanged, function(input)
                    if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        fromInput(input)
                    end
                end)
                connect(UIS.InputEnded, function(input)
                    if active and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                        active = false
                        tween(thumb, { Size = UDim2.fromOffset(12, 12) }, 0.12)
                        tween(thumbStroke, { Thickness = 2, Transparency = 0 }, 0.2)
                    end
                end)

                if id then Window.Controls[id] = { Set = set } end
                render(true)
                if id then Window.Config[id] = value end
                if cfg.Callback then task.spawn(cfg.Callback, value) end
                return { SetValue = set, GetValue = function() return value end }
            end

            -- Dropdown
            function Section:CreateDropdown(cfg)
                cfg = cfg or {}
                local choices = cfg.Options or {}
                local selected = cfg.CurrentOption
                if selected == nil then selected = choices[1] end
                local id = cfg.ConfigKey or cfg.Flag

                local r = makeRow(38, cfg.Name, true)
                rowLabel(r, cfg.Name or "Dropdown", 200)
                local valueLbl = label(r, tostring(selected or "Select"), "Accent", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -34, 0.5, 0), Size = UDim2.fromOffset(170, 18),
                    TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
                })
                local chev = label(r, "▾", "Muted", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -18, 0.5, 0), Size = UDim2.fromOffset(16, 16),
                    TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center,
                })

                local function set(option)
                    if table.find(choices, option) == nil then return end
                    selected = option
                    valueLbl.Text = tostring(option)
                    if id then Window.Config[id] = option end
                    if cfg.Callback then task.spawn(cfg.Callback, option) end
                    closeDropdown()
                end

                r.Activated:Connect(function()
                    local d = Window._dd
                    if d and d.owner == r then closeDropdown() return end
                    closeDropdown()

                    local s = uiScale.Scale
                    local mainAbs, rowAbs, rowSz = main.AbsolutePosition, r.AbsolutePosition, r.AbsoluteSize
                    local itemH, gap, padV = 28, 2, 6
                    local contentH = #choices * itemH + math.max(#choices - 1, 0) * gap + padV * 2
                    local menuH, menuW = math.min(contentH, 184), 210
                    local relX = (rowAbs.X - mainAbs.X + rowSz.X) / s - menuW - 6
                    local relY = (rowAbs.Y - mainAbs.Y + rowSz.Y) / s + 4
                    if relY + menuH + 8 > main.AbsoluteSize.Y / s then
                        relY = (rowAbs.Y - mainAbs.Y) / s - menuH - 4
                    end

                    local backdrop = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 50 }, main)
                    backdrop.Activated:Connect(closeDropdown)

                    local menu = make("ScrollingFrame", {
                        Position = UDim2.fromOffset(relX, relY), Size = UDim2.fromOffset(menuW, 0), BorderSizePixel = 0,
                        ClipsDescendants = true, ScrollBarThickness = 3, ScrollBarImageTransparency = 0.4,
                        CanvasSize = UDim2.new(0, 0, 0, contentH), ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 51,
                    }, main, { BackgroundColor3 = "Section", ScrollBarImageColor3 = "Muted" })
                    corner(menu, 8)
                    strokeT(menu, "Border", 1, 0)
                    new("UIListLayout", { Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder }, menu)
                    new("UIPadding", { PaddingTop = UDim.new(0, padV), PaddingBottom = UDim.new(0, padV), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 8) }, menu)

                    for i, option in ipairs(choices) do
                        local isSel = option == selected
                        local item = make("TextButton", {
                            Size = UDim2.new(1, 0, 0, itemH), Text = tostring(option), Font = Enum.Font.GothamMedium, TextSize = 12,
                            BorderSizePixel = 0, AutoButtonColor = false, LayoutOrder = i, ZIndex = 52,
                            TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = isSel and 0.85 or 1,
                        }, menu, { BackgroundColor3 = isSel and "Accent" or "Element", TextColor3 = isSel and "Accent" or "Text" })
                        corner(item, 6)
                        local itemPad = new("UIPadding", { PaddingLeft = UDim.new(0, 2) }, item)
                        item.TextTransparency = 1
                        task.delay(0.03 * i, function()
                            if item.Parent then
                                tween(item, { TextTransparency = 0 }, 0.2)
                                tween(itemPad, { PaddingLeft = UDim.new(0, 10) }, 0.3, Enum.EasingStyle.Back)
                            end
                        end)
                        item.MouseEnter:Connect(function()
                            if not isSel then tween(item, { BackgroundTransparency = 0 }, 0.12) end
                            tween(itemPad, { PaddingLeft = UDim.new(0, 14) }, 0.15)
                        end)
                        item.MouseLeave:Connect(function()
                            if not isSel then tween(item, { BackgroundTransparency = 1 }, 0.12) end
                            tween(itemPad, { PaddingLeft = UDim.new(0, 10) }, 0.15)
                        end)
                        item.Activated:Connect(function() set(option) end)
                    end

                    Window._dd = {
                        menu = menu, backdrop = backdrop, owner = r,
                        onClose = function() tween(chev, { Rotation = 0 }, 0.2) end,
                    }
                    tween(chev, { Rotation = 180 }, 0.2)
                    tween(menu, { Size = UDim2.fromOffset(menuW, menuH) }, 0.25)
                end)

                if id then Window.Controls[id] = { Set = set } end
                if id then Window.Config[id] = selected end
                if cfg.Callback and selected ~= nil then task.spawn(cfg.Callback, selected) end
                return {
                    SetValue = set,
                    GetValue = function() return selected end,
                    Refresh = function(_, newOptions)
                        choices = newOptions or {}
                        if table.find(choices, selected) == nil then
                            selected = choices[1]
                            valueLbl.Text = tostring(selected or "Select")
                            if id then Window.Config[id] = selected end
                        end
                    end,
                }
            end

            -- Textbox
            function Section:CreateTextbox(cfg)
                cfg = cfg or {}
                local id = cfg.ConfigKey or cfg.Flag
                local value = cfg.CurrentValue or ""
                local r = makeRow(38, cfg.Name, false)
                rowLabel(r, cfg.Name or "Textbox", 168)
                local box = make("TextBox", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(150, 26),
                    Text = value, PlaceholderText = cfg.PlaceholderText or "Enter text...", Font = Enum.Font.Gotham, TextSize = 12,
                    ClearTextOnFocus = false, BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left,
                }, r, { BackgroundColor3 = "Background", TextColor3 = "Text", PlaceholderColor3 = "Muted" })
                corner(box, 6)
                new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, box)
                local st = strokeT(box, "Border", 1, 0.3)
                box.Focused:Connect(function()
                    tween(st, { Color = theme.Accent, Transparency = 0, Thickness = 1.5 }, 0.2)
                    tween(box, { Size = UDim2.fromOffset(168, 26) }, 0.25, Enum.EasingStyle.Back)
                end)
                local function set(nv)
                    value = tostring(nv or "")
                    box.Text = value
                    if id then Window.Config[id] = value end
                    if cfg.Callback then task.spawn(cfg.Callback, value, false) end
                end
                box.FocusLost:Connect(function(enter)
                    tween(st, { Color = theme.Border, Transparency = 0.3, Thickness = 1 }, 0.2)
                    tween(box, { Size = UDim2.fromOffset(150, 26) }, 0.25)
                    value = box.Text
                    if id then Window.Config[id] = value end
                    if cfg.Callback then task.spawn(cfg.Callback, value, enter) end
                end)
                if id then Window.Controls[id] = { Set = set } Window.Config[id] = value end
                return { SetValue = set, GetValue = function() return value end, Box = box }
            end

            -- Keybind
            function Section:CreateKeybind(cfg)
                cfg = cfg or {}
                local key = cfg.CurrentKey or Enum.KeyCode.K
                local id = cfg.ConfigKey or cfg.Flag
                local listening = false
                local r = makeRow(38, cfg.Name, false)
                rowLabel(r, cfg.Name or "Keybind", 110)
                local b = make("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(92, 26),
                    Text = key.Name, Font = Enum.Font.GothamMedium, TextSize = 12, BorderSizePixel = 0, AutoButtonColor = false,
                }, r, { BackgroundColor3 = "Background", TextColor3 = "Accent" })
                corner(b, 6)
                local st = strokeT(b, "Border", 1, 0.3)
                local listenLoop = 0
                local function set(nk)
                    if typeof(nk) ~= "EnumItem" or nk.EnumType ~= Enum.KeyCode then return end
                    key = nk
                    b.Text = key.Name
                    if id then Window.Config[id] = key.Name end
                end
                local function stopListening()
                    listening = false
                    listenLoop += 1
                    b.Text = key.Name
                    tween(st, { Color = theme.Border, Transparency = 0.3 }, 0.2)
                end
                b.Activated:Connect(function()
                    if listening then stopListening() return end
                    listening = true
                    listenLoop += 1
                    local tok = listenLoop
                    b.Text = "Press a key"
                    tween(st, { Color = theme.Accent, Transparency = 0 }, 0.2)
                    -- blinking border while waiting for input
                    task.spawn(function()
                        while listening and listenLoop == tok and b.Parent do
                            tween(st, { Transparency = 0.7 }, 0.45, Enum.EasingStyle.Sine)
                            task.wait(0.45)
                            tween(st, { Transparency = 0 }, 0.45, Enum.EasingStyle.Sine)
                            task.wait(0.45)
                        end
                    end)
                end)
                local conn = connect(UIS.InputBegan, function(input, processed)
                    if listening then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            if input.KeyCode ~= Enum.KeyCode.Escape then set(input.KeyCode) end
                            stopListening()
                        end
                        return
                    end
                    if processed or UIS:GetFocusedTextBox() then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
                        tween(b, { Size = UDim2.fromOffset(86, 24) }, 0.07)
                        task.delay(0.07, function() tween(b, { Size = UDim2.fromOffset(92, 26) }, 0.2, Enum.EasingStyle.Back) end)
                        if cfg.Callback then task.spawn(cfg.Callback, key) end
                    end
                end)
                if id then
                    Window.Controls[id] = {
                        Set = function(v)
                            if typeof(v) == "string" then
                                local ok, res = pcall(function() return Enum.KeyCode[v] end)
                                if ok and res then set(res) end
                            else
                                set(v)
                            end
                        end,
                    }
                    Window.Config[id] = key.Name
                end
                return { SetValue = set, GetValue = function() return key end, Disconnect = function() conn:Disconnect() end }
            end

            -- Label / Paragraph / Divider
            function Section:CreateLabel(cfg)
                local text = type(cfg) == "table" and (cfg.Text or cfg.Name) or cfg or ""
                order += 1
                local l = label(sf, text, "Muted", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Gotham, TextSize = 12,
                    TextWrapped = true, LayoutOrder = order, TextYAlignment = Enum.TextYAlignment.Top,
                })
                new("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }, l)
                table.insert(Section.Rows, { Frame = l, Text = "" })
                return { SetText = function(_, t) l.Text = t end }
            end
            function Section:CreateParagraph(cfg)
                cfg = cfg or {}
                order += 1
                local card = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0, LayoutOrder = order, BackgroundTransparency = 0.2 }, sf, { BackgroundColor3 = "Element" })
                corner(card, 8)
                strokeT(card, "Border", 1, 0.4)
                new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 12) }, card)
                new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, card)
                label(card, cfg.Title or "", "Text", { Size = UDim2.new(1, 0, 0, 18), Font = Enum.Font.GothamBold, LayoutOrder = 1 })
                local body = label(card, cfg.Content or "", "Muted", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Gotham, TextSize = 12,
                    TextWrapped = true, LayoutOrder = 2, TextYAlignment = Enum.TextYAlignment.Top,
                })
                table.insert(Section.Rows, { Frame = card, Text = cfg.Title or "" })
                return { SetContent = function(_, t) body.Text = t end }
            end
            function Section:CreateDivider()
                order += 1
                local d = make("Frame", { Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0, LayoutOrder = order, BackgroundColor3 = Color3.new(1, 1, 1) }, sf)
                accentGrad(d, 0)
                local g = d:FindFirstChildOfClass("UIGradient")
                if g then
                    g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 1) })
                end
                table.insert(Section.Rows, { Frame = d, Text = "" })
            end

            return Section
        end

        table.insert(Window.Tabs, Tab)
        if #Window.Tabs == 1 then task.defer(function() selectTab(Tab) end) end
        return Tab
    end

    ---------------------------------------------------------------- ready-made settings tab
    -- Window:CreateSettingsTab("Settings") adds a tab with a theme picker and a background-effect picker
    function Window:CreateSettingsTab(tabName)
        local tab = Window:CreateTab(tabName or "Settings")
        local sec = tab:CreateSection("Appearance")
        local ready = false -- ignore the callbacks fired while the dropdowns are being created

        local names = UI:GetThemeNames()
        sec:CreateDropdown({
            Name = "Theme", Options = names, ConfigKey = "ui_theme",
            CurrentOption = table.find(names, Window.ThemeName) and Window.ThemeName or nil,
            Callback = function(v)
                if ready and v ~= Window.ThemeName then Window:SetTheme(v) end
            end,
        })

        local fxNames = { "Theme Default", "Bats", "Snow", "Sakura", "Embers", "Bubbles", "Matrix", "Stars", "Aurora", "Grid", "Fireflies", "Rain", "None" }
        sec:CreateDropdown({
            Name = "Background", Options = fxNames, ConfigKey = "ui_background",
            CurrentOption = (Window.FxOverride and table.find(fxNames, Window.FxOverride)) and Window.FxOverride or "Theme Default",
            Callback = function(v)
                if ready then Window:SetFx(v) end
            end,
        })
        task.defer(function() ready = true end)

        local tests = tab:CreateSection("Preview")
        tests:CreateButton({
            Name = "Send test notification",
            Callback = function()
                Window:Notify({ Title = "Looking good", Content = "Theme: " .. tostring(Window.ThemeName), Type = "Success" })
            end,
        })
        return tab
    end

    ---------------------------------------------------------------- lifecycle
    function Window:Destroy()
        if Window.Destroyed then return end
        gui:Destroy()
    end
    gui.Destroying:Connect(function()
        Window.Destroyed = true
        for _, c in ipairs(conns) do c:Disconnect() end
        for i, w in ipairs(UI.Windows) do
            if w == Window then table.remove(UI.Windows, i) break end
        end
    end)

    -- intro
    tween(uiScale, { Scale = scale }, 0.55, Enum.EasingStyle.Back)
    tween(main, { GroupTransparency = 0 }, 0.3)
    tween(shadow, { ImageTransparency = 0.5 }, 0.4)
    task.delay(0.35, playSweep)

    return Window
end

return UI
