    local verifyGrad = new("UIGradient", { Color = accentSeq(theme), Rotation = 0 }, verifyBtn)
    spin(verifyGrad, 5)

    getBtn.MouseEnter:Connect(function() tween(getBtn, { BackgroundColor3 = theme.ElementHover }, 0.15) end)
    getBtn.MouseLeave:Connect(function() tween(getBtn, { BackgroundColor3 = theme.Element }, 0.15) end)
    verifyBtn.MouseEnter:Connect(function() tween(verifyBtn, { BackgroundTransparency = 0.12 }, 0.15) end)
    verifyBtn.MouseLeave:Connect(function() tween(verifyBtn, { BackgroundTransparency = 0 }, 0.15) end)

    getBtn.Activated:Connect(function()
        local link = options.GetKeyLink or "https://example.com/get-key"
        local ok = pcall(function() setclipboard(link) end)
        if ok then
            setStatus("Link copied to clipboard.", theme.Success)
        else
            setStatus(link, theme.Muted)
        end
    end)

    local busy = false
    local function attempt()
        if busy then return end
        busy = true
        local input = string.match(box.Text, "^%s*(.-)%s*$")

        -- "checking" dots
        for i = 1, 6 do
            verifyBtn.Text = "Checking" .. string.rep(".", (i % 3) + 1)
            task.wait(0.1)
        end

        if isValid(input) then
            verifyBtn.Text = "Verified"
            verifyGrad.Color = ColorSequence.new(theme.Success, theme.Success)
            tween(boxStroke, { Color = theme.Success }, 0.25)
            setStatus("Key accepted.", theme.Success)
            burst(card, card.AbsoluteSize.X / rootScale.Scale / 2, 250, theme.Success, 14, 60, 20)
            task.wait(0.7)
            tween(card, { GroupTransparency = 1 }, 0.3)
            tween(shadow, { ImageTransparency = 1 }, 0.3)
            tween(rootScale, { Scale = 0.94 }, 0.3)
            tween(dim, { BackgroundTransparency = 1 }, 0.35)
            if blur then tween(blur, { Size = 0 }, 0.35) end
            task.wait(0.4)
            if blur then blur:Destroy() end
            gui:Destroy()
            if options.OnSuccess then task.spawn(options.OnSuccess) end
        else
            verifyBtn.Text = "Verify"
            setStatus(input == "" and "Please enter a key." or "Invalid key. Please try again.", theme.Danger)
            tween(boxStroke, { Color = theme.Danger }, 0.15)
            task.spawn(function()
                local origin = root.Position
                for i = 1, 6 do
                    local dir = (i % 2 == 0) and 1 or -1
                    tween(root, { Position = origin + UDim2.fromOffset(dir * (10 - i), 0) }, 0.04)
                    task.wait(0.04)
                end
                tween(root, { Position = origin }, 0.1)
            end)
            busy = false
            task.delay(2, function()
                if busy or not gui.Parent then return end
                tween(status, { TextTransparency = 1 }, 0.4)
                tween(boxStroke, { Color = box:IsFocused() and theme.Accent or theme.Border }, 0.4)
            end)
        end
    end
    verifyBtn.Activated:Connect(attempt)
    box.FocusLost:Connect(function(enter) if enter then attempt() end end)

    return gui
end

--==== MAIN WINDOW ====--
function UI:CreateWindow(options)
    options = options or {}
    local theme = resolveTheme(options.Theme or "GreyWhite")
    local themeName = type(options.Theme) == "string" and options.Theme or "Custom"
    local windowName = options.Name or "IncrementalUi"

    -- sizing
    local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
    local cam = workspace.CurrentCamera
    local viewport = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local baseW, baseH = 660, 440
    local baseSize = options.Size or UDim2.fromOffset(baseW, baseH)
    local fullW = baseSize.X.Offset > 0 and baseSize.X.Offset or baseW
    local fullH = baseSize.Y.Offset > 0 and baseSize.Y.Offset or baseH
    local scale = math.min((viewport.X - (mobile and 30 or 40)) / fullW, (viewport.Y - (mobile and 90 or 40)) / fullH, mobile and 0.85 or 1)
    scale = math.clamp(scale, 0.55, 1)

    local HEADER_H, SIDEBAR_W = 44, 164

    local gui = new("ScreenGui", {
        Name = "IncrementalUi_" .. string.sub(HttpService:GenerateGUID(false), 1, 6),
        ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, playerGui())

    ---------------------------------------------------------------- theming
    local bindings, hooks, conns = {}, {}, {}

    local function make(class, props, parent, themed)
        local o = new(class, props, nil)
        if themed then
            for prop, key in pairs(themed) do
                o[prop] = theme[key]
                table.insert(bindings, { o, prop, key })
            end
        end
        o.Parent = parent
        return o
    end
    local function onTheme(fn) table.insert(hooks, fn) end
    local function connect(signal, fn)
        local c = signal:Connect(fn)
        table.insert(conns, c)
        return c
    end
    local function strokeT(parent, key, thickness, transparency)
        return make("UIStroke", {
            Thickness = thickness or 1, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, parent, { Color = key or "Border" })
    end
    local function label(parent, text, key, props)
        local p = {
            BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamMedium, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(1, 1),
        }
        for k, v in pairs(props or {}) do p[k] = v end
        return make("TextLabel", p, parent, { TextColor3 = key or "Text" })
    end

    -- two-tone gradients that follow the theme
    local accentGrads = {}
    local function accentGrad(parent, rotation)
        local g = new("UIGradient", { Color = accentSeq(theme), Rotation = rotation or 0 }, parent)
        table.insert(accentGrads, g)
        return g
    end
    local borderGrads = {}

    local function refreshTheme()
        for i = #bindings, 1, -1 do
            local b = bindings[i]
            if b[1]:IsDescendantOf(gui) then
                tween(b[1], { [b[2]] = theme[b[3]] }, 0.3)
            else
                table.remove(bindings, i)
            end
        end
        for i = #accentGrads, 1, -1 do
            local g = accentGrads[i]
            if g.Parent then g.Color = accentSeq(theme) else table.remove(accentGrads, i) end
        end
        for i = #borderGrads, 1, -1 do
            local g = borderGrads[i]
            if g.Parent then g.Color = borderSeq(theme) else table.remove(borderGrads, i) end
        end
        for _, fn in ipairs(hooks) do fn() end
    end

    ---------------------------------------------------------------- frame
    local root = new("Frame", {
        Name = "Root", Size = baseSize, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1,
    }, gui)
    local uiScale = new("UIScale", { Scale = scale * 0.94 }, root)
    local shadow = makeShadow(root, 60, 1)

    local main = make("CanvasGroup", {
        Name = "Main", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, GroupTransparency = 1,
    }, root, { BackgroundColor3 = "Background" })
    corner(main, 12)

    -- rotating comet border
    local borderStroke = new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1.5, Transparency = 0.1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, main)
    local borderGrad = new("UIGradient", { Color = borderSeq(theme) }, borderStroke)
    table.insert(borderGrads, borderGrad)
    spin(borderGrad, 7)

    -- background layer: drifting light band + cursor spotlight + flying bats (sits under all content)
    local batLayer = new("Frame", { Name = "Background", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 1 }, main)
    local glow = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 1 }, batLayer)
    local glowGrad = new("UIGradient", {
        Rotation = 30, Offset = Vector2.new(-1, 0),
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.955), NumberSequenceKeypoint.new(1, 1) }),
    }, glow)
    task.spawn(function()
        while glow.Parent do
            glowGrad.Offset = Vector2.new(-1, 0)
            tween(glowGrad, { Offset = Vector2.new(1, 0) }, 9, Enum.EasingStyle.Linear)
            task.wait(9.5)
        end
    end)

    -- spotlight that follows the cursor
    local spot = make("ImageLabel", {
        Name = "Spotlight", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(280, 280), Position = UDim2.fromOffset(-300, -300),
        BackgroundTransparency = 1, Image = SHADOW_IMAGE, ImageTransparency = 1,
        ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), ZIndex = 1,
    }, batLayer, { ImageColor3 = "Accent" })

    local function playSweep()
        local sw = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0.3, 0, 1.8, 0), Position = UDim2.fromScale(-0.3, 0.5),
            Rotation = 18, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 30,
        }, main)
        new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.9), NumberSequenceKeypoint.new(1, 1) }) }, sw)
        tween(sw, { Position = UDim2.fromScale(1.3, 0.5) }, 0.9, Enum.EasingStyle.Quad)
        task.delay(1, function() sw:Destroy() end)
    end

    local Window = {
        ScreenGui = gui, Root = root, Main = main, Tabs = {}, ActiveTab = nil, Config = {}, NamedConfigs = {},
        Controls = {}, Theme = theme, ThemeName = themeName, Visible = true, Destroyed = false,
        Keybind = options.Keybind or Enum.KeyCode.RightControl, _dd = nil,
    }
    table.insert(UI.Windows, Window)

    ---------------------------------------------------------------- background effects
    local fxLayer = new("Frame", { Name = "Fx", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0 }, batLayer)
    local fxToken = 0
    local rand = math.random
    local nk = NumberSequenceKeypoint.new
    local white = Color3.new(1, 1, 1)

    local bats = {}
    function Window:SpawnBat()
        local b = spawnBat(fxLayer)
        table.insert(bats, b)
        return b
    end
    function Window:ClearBats()
        for _, b in ipairs(bats) do b:Destroy() end
        table.clear(bats)
    end
    function Window:SetBats(n)
        Window:ClearBats()
        for _ = 1, n or 0 do Window:SpawnBat() end
    end
    local batCount = options.Bats
    if batCount == nil or batCount == true then batCount = 7 elseif batCount == false then batCount = 0 end

    local function dot(size, color)
        local f = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size), BackgroundColor3 = color,
            BorderSizePixel = 0, ZIndex = 1,
        })
        corner(f, 999)
        return f
    end
    local function glyph(text, size)
        return new("TextLabel", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
            Text = text, TextSize = size, Font = Enum.Font.GothamBold, TextColor3 = white, ZIndex = 1,
        })
    end

    -- keeps `count` particles alive, each one spawning, travelling, fading and respawning
    local function emit(tok, count, spec)
        for _ = 1, count do
            task.spawn(function()
                task.wait(rand() * (spec.stagger or 4))
                while fxToken == tok and fxLayer.Parent do
                    local obj = spec.make()
                    local a, b, dur = spec.path()
                    obj.Position = a
                    obj[spec.prop] = 1
                    obj.Parent = fxLayer
                    tween(obj, { [spec.prop] = spec.base }, dur * 0.2, Enum.EasingStyle.Linear)
                    local goal = { Position = b }
                    if spec.rot then goal.Rotation = spec.rot() end
                    tween(obj, goal, dur, spec.style or Enum.EasingStyle.Linear, spec.dir or Enum.EasingDirection.Out)
                    task.delay(dur * 0.75, function()
                        if obj.Parent then tween(obj, { [spec.prop] = 1 }, dur * 0.25, Enum.EasingStyle.Linear) end
                    end)
                    task.wait(dur)
                    obj:Destroy()
                end
            end)
        end
    end

    local FX = {}

    FX.Bats = function() Window:SetBats(batCount) end

    FX.Snow = function(tok)
        emit(tok, 34, {
            prop = "BackgroundTransparency", base = 0.3, stagger = 6,
            make = function() return dot(rand(2, 5), white) end,
            path = function()
                local x = rand()
                return UDim2.fromScale(x, -0.05), UDim2.fromScale(x + (rand() - 0.5) * 0.2, 1.05), 5 + rand() * 5
            end,
        })
    end

    FX.Sakura = function(tok)
        emit(tok, 16, {
            prop = "TextTransparency", base = 0.2, stagger = 8, style = Enum.EasingStyle.Sine,
            make = function() return glyph("🌸", rand(13, 20)) end,
            path = function()
                local x = rand() * 1.1
                return UDim2.fromScale(x, -0.08), UDim2.fromScale(x - 0.35, 1.08), 6 + rand() * 4
            end,
            rot = function() return rand(-360, 360) end,
        })
    end

    FX.Embers = function(tok)
        emit(tok, 30, {
            prop = "BackgroundTransparency", base = 0.15, stagger = 5,
            make = function()
                local d = dot(rand(2, 4), rand() < 0.5 and theme.Accent or theme.Accent2)
                new("UIStroke", { Color = d.BackgroundColor3, Thickness = 2, Transparency = 0.75 }, d)
                return d
            end,
            path = function()
                local x = rand()
                return UDim2.fromScale(x, 1.05), UDim2.fromScale(x + (rand() - 0.5) * 0.25, -0.05), 3 + rand() * 3
            end,
        })
    end

    FX.Bubbles = function(tok)
        emit(tok, 18, {
            prop = "BackgroundTransparency", base = 0.8, stagger = 7, style = Enum.EasingStyle.Sine,
            make = function() return dot(rand(6, 18), white) end,
            path = function()
                local x = rand()
                return UDim2.fromScale(x, 1.08), UDim2.fromScale(x + (rand() - 0.5) * 0.12, -0.08), 6 + rand() * 5
            end,
        })
    end

    FX.Matrix = function(tok)
        local chars = "0123456789ABCDEFXYZ$#@%&"
        emit(tok, 24, {
            prop = "TextTransparency", base = 0.05, stagger = 4,
            make = function()
                local lines = {}
                for i = 1, 8 do
                    local c = rand(1, #chars)
                    lines[i] = string.sub(chars, c, c)
                end
                local l = new("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 110), BackgroundTransparency = 1,
                    Text = table.concat(lines, "\n"), TextSize = 12, Font = Enum.Font.Code, TextColor3 = theme.Accent, ZIndex = 1,
                })
                new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ nk(0, 1), nk(1, 0) }) }, l)
                return l
            end,
            path = function()
                local x = rand(2, 98) / 100
                return UDim2.fromScale(x, -0.25), UDim2.fromScale(x, 1.2), 2.5 + rand() * 2.5
            end,
        })
    end

    FX.Stars = function(tok)
        for _ = 1, 46 do
            local s = dot(rand(1, 3), white)
            s.Position = UDim2.fromScale(rand(), rand())
            s.BackgroundTransparency = 0.3 + rand() * 0.6
            s.Parent = fxLayer
            task.spawn(function()
                while fxToken == tok and s.Parent do
                    local d = 0.8 + rand() * 1.8
                    tween(s, { BackgroundTransparency = 0.1 + rand() * 0.85 }, d, Enum.EasingStyle.Sine)
                    task.wait(d)
                end
            end)
        end
        task.spawn(function() -- shooting stars
            while fxToken == tok and fxLayer.Parent do
                task.wait(2.5 + rand() * 4)
                if fxToken ~= tok then break end
                local px, py = rand() * 0.6, rand() * 0.4
                local st = new("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(70, 2), Position = UDim2.fromScale(px, py),
                    Rotation = 28, BackgroundColor3 = white, BorderSizePixel = 0, ZIndex = 1,
                }, fxLayer)
                new("UIGradient", { Transparency = NumberSequence.new({ nk(0, 1), nk(1, 0) }) }, st)
                tween(st, { Position = UDim2.fromScale(px + 0.35, py + 0.3) }, 0.8, Enum.EasingStyle.Quad)
                tween(st, { BackgroundTransparency = 1 }, 0.8, Enum.EasingStyle.Quad)
                task.delay(0.9, function() st:Destroy() end)
            end
        end)
    end

    FX.Aurora = function(tok)
        local cols = { theme.Accent, theme.Accent2, theme.Accent:Lerp(theme.Accent2, 0.5) }
        for i = 1, 3 do
            local band = new("ImageLabel", {
                AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.45, 1.5), Position = UDim2.fromScale(0.15 + i * 0.25, 0.4),
                Rotation = -20 + i * 14, BackgroundTransparency = 1, Image = SHADOW_IMAGE, ImageColor3 = cols[i], ImageTransparency = 0.84,
                ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), ZIndex = 1,
            }, fxLayer)
            task.spawn(function()
                while fxToken == tok and band.Parent do
                    local d = 5 + rand() * 4
                    tween(band, {
                        Position = UDim2.fromScale(0.1 + rand() * 0.8, 0.3 + rand() * 0.2),
                        Rotation = rand(-30, 30), Size = UDim2.fromScale(0.35 + rand() * 0.3, 1.4 + rand() * 0.3),
                        ImageTransparency = 0.78 + rand() * 0.12,
                    }, d, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                    task.wait(d)
                end
            end)
        end
    end

    FX.Grid = function(tok)
        local vpY = 0.38
        -- horizon glow
        new("ImageLabel", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, vpY), Size = UDim2.new(1.1, 0, 0, 90),
            BackgroundTransparency = 1, Image = SHADOW_IMAGE, ImageColor3 = theme.Accent, ImageTransparency = 0.82,
            ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), ZIndex = 1,
        }, fxLayer)
        -- perspective lines radiating from the vanishing point
        local dy = fullH * 0.75
        for k = -6, 6 do
            local dx = k * 0.2 * fullW
            local line = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, vpY, 0),
                Size = UDim2.fromOffset(1, math.sqrt(dx * dx + dy * dy)), Rotation = -math.deg(math.atan2(dx, dy)),
                BackgroundColor3 = theme.Accent2, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 1,
            }, fxLayer)
            new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ nk(0, 1), nk(0.35, 0.6), nk(1, 0) }) }, line)
        end
        -- scrolling horizontal lines (ease in for depth)
        emit(tok, 7, {
            prop = "BackgroundTransparency", base = 0.7, stagger = 2.8, style = Enum.EasingStyle.Quad, dir = Enum.EasingDirection.In,
            make = function()
                return new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = theme.Accent, BorderSizePixel = 0, ZIndex = 1 })
            end,
            path = function() return UDim2.fromScale(0.5, vpY), UDim2.fromScale(0.5, 1.05), 2.8 end,
        })
        -- scanline
        task.spawn(function()
            local scan = new("Frame", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromScale(0, -0.1), BackgroundColor3 = white, BorderSizePixel = 0, ZIndex = 2 }, fxLayer)
            new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ nk(0, 1), nk(0.5, 0.93), nk(1, 1) }) }, scan)
            while fxToken == tok and scan.Parent do
                scan.Position = UDim2.fromScale(0, -0.1)
                tween(scan, { Position = UDim2.fromScale(0, 1.05) }, 3.5, Enum.EasingStyle.Linear)
                task.wait(4.2)
            end
        end)
    end

    FX.Fireflies = function(tok)
        for _ = 1, 18 do
            local f = dot(rand(3, 5), rand() < 0.7 and theme.Accent2 or theme.Accent)
            f.Position = UDim2.fromScale(rand(), rand())
            f.Parent = fxLayer
            new("UIStroke", { Color = f.BackgroundColor3, Thickness = 3, Transparency = 0.7 }, f)
            task.spawn(function()
                task.wait(rand() * 2)
                while fxToken == tok and f.Parent do
                    local d = 3 + rand() * 3
                    local p = f.Position
                    tween(f, {
                        Position = UDim2.fromScale(
                            math.clamp(p.X.Scale + (rand() - 0.5) * 0.3, 0.02, 0.98),
                            math.clamp(p.Y.Scale + (rand() - 0.5) * 0.3, 0.03, 0.97)
                        ),
                    }, d, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                    tween(f, { BackgroundTransparency = 0.05 }, d / 2, Enum.EasingStyle.Sine)
                    task.wait(d / 2)
                    tween(f, { BackgroundTransparency = 0.85 }, d / 2, Enum.EasingStyle.Sine)
                    task.wait(d / 2)
                end
            end)
        end
    end

    FX.Rain = function(tok)
        emit(tok, 46, {
            prop = "BackgroundTransparency", base = 0.65, stagger = 1.5,
            make = function()
                return new("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(1, rand(10, 18)), Rotation = 12,
                    BackgroundColor3 = theme.Accent2, BorderSizePixel = 0, ZIndex = 1,
                })
            end,
            path = function()
                local x = rand() * 1.1
                return UDim2.fromScale(x, -0.08), UDim2.fromScale(x - 0.08, 1.08), 0.7 + rand() * 0.5
            end,
        })
        task.spawn(function() -- lightning
            while fxToken == tok and fxLayer.Parent do
                task.wait(4 + rand() * 6)
                if fxToken ~= tok then break end
                local fl = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = white, BackgroundTransparency = 0.86, BorderSizePixel = 0, ZIndex = 2 }, fxLayer)
                tween(fl, { BackgroundTransparency = 1 }, 0.15)
                task.wait(0.2)
                fl.BackgroundTransparency = 0.9
                tween(fl, { BackgroundTransparency = 1 }, 0.45)
                task.delay(0.5, function() fl:Destroy() end)
            end
        end)
    end

    Window.Fx = "Bats"
    Window.FxOverride = options.Fx
    local function applyFx(name)
        fxToken += 1
        Window:ClearBats()
        fxLayer:ClearAllChildren()
        Window.Fx = name
        local f = FX[name]
        if f then f(fxToken) end
    end
    -- name: "Bats", "Snow", "Sakura", "Embers", "Bubbles", "Matrix", "Stars", "Aurora", "Grid", "Fireflies", "Rain", "None"
    -- pass nil (or "Theme Default") to go back to the active theme's own effect
    function Window:SetFx(name)
        if name == nil or name == "Theme" or name == "Theme Default" then Window.FxOverride = nil else Window.FxOverride = name end
        applyFx(Window.FxOverride or theme.Fx or "Bats")
    end
    applyFx(Window.FxOverride or theme.Fx or "Bats")

    -- local helper: convert a screen position to a position inside `main`
    local function toMain(pos)
        local s = uiScale.Scale
        return (pos.X - main.AbsolutePosition.X) / s, (pos.Y - main.AbsolutePosition.Y) / s
    end
    local function insideMain(x, y)
        return x >= 0 and y >= 0 and x <= main.AbsoluteSize.X / uiScale.Scale and y <= main.AbsoluteSize.Y / uiScale.Scale
    end

    -- cursor spotlight + click sparks
    connect(UIS.InputChanged, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement or not Window.Visible then return end
        local x, y = toMain(input.Position)
        if insideMain(x, y) then
            tween(spot, { Position = UDim2.fromOffset(x, y), ImageTransparency = 0.82 }, 0.18, Enum.EasingStyle.Quad)
        else
            tween(spot, { ImageTransparency = 1 }, 0.3)
        end
    end)
