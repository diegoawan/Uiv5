    ---------------------------------------------------------------- dropdown management
    local function closeDropdown()
        local d = Window._dd
        if not d then return end
        Window._dd = nil
        if d.onClose then d.onClose() end
        if d.backdrop then d.backdrop:Destroy() end
        if d.menu then
            local menu = d.menu
            tween(menu, { Size = UDim2.fromOffset(menu.AbsoluteSize.X / uiScale.Scale, 0) }, 0.15)
            task.delay(0.16, function() if menu.Parent then menu:Destroy() end end)
        end
    end

    ---------------------------------------------------------------- theming API
    function Window:SetTheme(name)
        local t = resolveTheme(name)
        for k, v in pairs(t) do theme[k] = v end
        Window.ThemeName = type(name) == "string" and name or "Custom"
        refreshTheme()
        applyFx(Window.FxOverride or theme.Fx or "Bats")
        return true
    end
    function Window:SetCustomTheme(custom)
        if typeof(custom) ~= "table" then return false end
        for k, v in pairs(custom) do
            if typeof(theme[k]) == "Color3" and typeof(v) == "Color3" then theme[k] = v end
        end
        if typeof(custom.Accent) == "Color3" and typeof(custom.Accent2) ~= "Color3" then
            theme.Accent2 = theme.Accent:Lerp(rgb(120, 120, 140), 0.55)
        end
        if type(custom.Fx) == "string" then theme.Fx = custom.Fx end
        refreshTheme()
        applyFx(Window.FxOverride or theme.Fx or "Bats")
        return true
    end

    ---------------------------------------------------------------- search
    local function applySearch()
        local tab = Window.ActiveTab
        if not tab then return end
        local q = string.match(string.lower(searchBox.Text), "^%s*(.-)%s*$")
        for _, s in ipairs(tab.Sections) do
            local any = false
            for _, r in ipairs(s.Rows) do
                local vis = q == "" or (r.Text ~= "" and string.find(string.lower(r.Text), q, 1, true) ~= nil)
                r.Frame.Visible = vis
                if vis then any = true end
            end
            s.Frame.Visible = any or q == ""
        end
    end
    searchBox:GetPropertyChangedSignal("Text"):Connect(applySearch)

    ---------------------------------------------------------------- tab selection
    local typeToken = 0
    local function selectTab(tab)
        if Window.ActiveTab == tab then return end
        closeDropdown()
        local prev = Window.ActiveTab
        Window.ActiveTab = tab
        if prev then
            prev.Page.Visible = false
            prev.Paint()
        end
        tab.Paint()
        moveSelector(tab, prev == nil)
        tab.Page.Position = UDim2.fromOffset(0, 14)
        tab.Page.Visible = true
        tween(tab.Page, { Position = UDim2.fromOffset(0, 0) }, 0.4)

        -- typewriter page title
        typeToken += 1
        local tok = typeToken
        local full = tab.Name
        tab.Title.Text = ""
        task.spawn(function()
            for i = 1, #full do
                if typeToken ~= tok then tab.Title.Text = full return end
                tab.Title.Text = string.sub(full, 1, i) .. "▌"
                task.wait(0.03)
            end
            tab.Title.Text = full
        end)

        for i, sec in ipairs(tab.Sections) do
            sec.Frame.GroupTransparency = 1
            sec.Pad.PaddingLeft = UDim.new(0, 28)
            sec.Line.Size = UDim2.new(0, 0, 0, 1)
            task.delay((i - 1) * 0.07, function()
                if sec.Frame.Parent then
                    tween(sec.Frame, { GroupTransparency = 0 }, 0.45)
                    tween(sec.Pad, { PaddingLeft = UDim.new(0, 2) }, 0.55)
                    tween(sec.Line, { Size = UDim2.new(1, 10, 0, 1) }, 0.8)
                end
            end)
        end
        applySearch()
    end

